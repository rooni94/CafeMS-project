# Local-only example. Never commit real credentials or production values.
DEBUG=True
SECRET_KEY=local-development-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=SAR

# Push notifications
EXPO_ACCESS_TOKEN=
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# Apple Wallet / PassKit
APPLE_WWDR_PEM=
APPLE_PASS_P12=
APPLE_PASS_P12_PASSWORD=
APPLE_WALLET_WEB_SERVICE_URL=
APPLE_WALLET_APNS_SANDBOX=True
APPLE_WALLET_APNS_HOST=

# OTP provider
AUTHENTICA_API_KEY=
AUTHENTICA_BASE_URL=https://api.authentica.sa/api/v2
AUTHENTICA_OTP_METHOD=sms
AUTHENTICA_OTP_TEMPLATE_ID=1
AUTHENTICA_OTP_RESEND_SECONDS=60

# API policy
REST_THROTTLE_USER=120/min
REST_THROTTLE_ANON=30/min
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Optional voice support
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
VOICE_MAX_DURATION_SECONDS=90
VOICE_MAX_FILE_MB=15
WHISPER_MODEL_NAME=large-v3
WHISPER_MODEL_DIR=
WHISPER_COMPUTE_TYPE=int8_float16

# Frontend links and email
FRONTEND_URL=http://localhost:5173
CHECKOUT_REDIRECT_HOSTS=localhost,127.0.0.1
FRONTEND_RESET_PASSWORD_URL=http://localhost:5173/reset-password
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CafeMS <noreply@example.invalid>
EMAIL_TIMEOUT=10
